rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        (getUserDoc(request.auth.uid).data != null &&
         getUserDoc(request.auth.uid).data.role == 'SUPER_ADMIN')
      );
    }

    function isAgent() {
      return isAuth() && (
        request.auth.token.role == 'super_agent' ||
        request.auth.token.role == 'SUPER_AGENT' ||
        (getUserDoc(request.auth.uid).data != null &&
         getUserDoc(request.auth.uid).data.userRole == 'superAgent')
      );
    }

    function isOwner(uid) {
      return isAuth() && uid == request.auth.uid;
    }

    function fieldExists(field) {
      return field in resource.data;
    }

    function fieldUnchanged(field) {
      return !fieldExists(field) || request.resource.data[field] == resource.data[field];
    }

    // ─── Identity & access ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAgent() || isAdmin();
      allow create: if isOwner(userId) || isAgent() || isAdmin();
      allow update: if
        isAdmin() ||
        (isAgent() && fieldUnchanged("userRole")) ||
        (isOwner(userId) && fieldUnchanged("balance") && fieldUnchanged("userRole"));
      allow delete: if false;

      match /histories/{historyId} {
        allow read: if isOwner(userId) || isAgent() || isAdmin();
        allow create: if isOwner(userId) || isAgent() || isAdmin();
        allow update, delete: if false;
      }
    }

    // ─── Agents ───────────────────────────────────────────────────────
    match /agents/{agentId} {
      allow read: if isAgent() || isAdmin();
      allow write: if isAdmin() || isOwner(agentId);
    }

    // ─── Player wallet & ledger ───────────────────────────────────────
    match /points/{pointId} {
      allow read: if isOwner(pointId) || isAgent() || isAdmin();
      allow write: if isOwner(pointId) || isAgent() || isAdmin();

      match /histories/{historyId} {
        allow read: if isOwner(pointId) || isAgent() || isAdmin();
        allow create: if isOwner(pointId) || isAgent() || isAdmin();
        allow update, delete: if false;
      }
    }

    // ─── Global history ───────────────────────────────────────────────
    match /history/{historyId} {
      allow read: if isAgent() || isAdmin();
      allow create: if isAgent() || isAdmin();
      allow update, delete: if false;
    }

    // ─── Jackpot ──────────────────────────────────────────────────────
    match /jackpotHistory/{entryId} {
      allow read: if isAuth();
      allow create: if isAgent() || isAdmin();
      allow update, delete: if false;
    }

    match /jackpots/{jackpotId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /currentJackpot {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // ─── Transactions & games (api/ writes; clients may also read) ────
    match /transactions/{txnId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.amount <= 10000 &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'PENDING';
      allow update: if false;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    match /bets/{betId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.amount <= 1000 &&
                    request.resource.data.gameId != null &&
                    request.resource.data.status == 'ACTIVE';
      allow update: if false;
      allow delete: if false;
    }

    // ─── System ────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── Catch-all ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
